{%- comment -%}
  Basic Shop Metafield section

  Purpose
  - Outputs a shop-level metafield (namespace: "custom", key: "homepage_text").
  - Multilingual-ready and accessible by default.

  Accessibility
  - Uses a semantic heading with aria-labelledby for the region when a heading is present.
  - Falls back to aria-label (localized) if heading is left empty.
  - Content is rendered via metafield_tag for safe, type-aware output.

  Internationalization
  - Default heading and region label are localized via the sections.basic_shop_metafield.* keys.
  - The metafield value itself can be localized using Shopify Translate & Adapt or compatible apps.

  Configuration
  - Optional heading text and level (H2–H4).
  - Text alignment (left/center/right).
{%- endcomment -%}

{%- liquid
  assign metafield_object = blank
  if shop.metafields.custom and shop.metafields.custom.homepage_text != blank
    assign metafield_object = shop.metafields.custom.homepage_text
  endif

  assign display_mode = section.settings.display_mode | default: 'heading_and_text'
  assign heading_text = section.settings.heading
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign alignment = section.settings.text_alignment | default: 'left'
  assign region_label = 'sections.basic_shop_metafield.region_label' | t
  assign raw_value = blank
  if metafield_object != blank
    assign raw_value = metafield_object.value | default: metafield_object
  endif

  if display_mode == 'metafield_as_heading' and raw_value != blank
    assign heading_text = raw_value | strip_html | strip
  endif

  assign has_heading = false
  if heading_text != blank and display_mode != 'text_only'
    assign has_heading = true
  endif

  assign show_body = false
  if display_mode == 'heading_and_text' or display_mode == 'text_only'
    assign show_body = true
  endif
-%}

{%- if metafield_object != blank -%}
<section class="section-basic-shop-metafield align-{{ alignment }}" role="region" {%- if has_heading -%} aria-labelledby="Section-{{ section.id }}-heading" {%- else -%} aria-label="{{ region_label }}" {%- endif -%}>
  <div class="container">
    {%- if has_heading -%}
      <{{ heading_tag }} id="Section-{{ section.id }}-heading">{{ heading_text }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if show_body -%}
      <p id="Section-{{ section.id }}-content">{{ metafield_object | metafield_tag }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Basic shop metafield",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display",
      "default": "heading_and_text",
      "options": [
        { "value": "heading_and_text", "label": "Heading + text" },
        { "value": "heading_only", "label": "Heading only" },
        { "value": "text_only", "label": "Text only" },
        { "value": "metafield_as_heading", "label": "Use metafield as heading" }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    { "name": "Basic shop metafield" }
  ]
}
{% endschema %}